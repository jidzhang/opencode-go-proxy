.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
dist/
build/
*.egg-info/
tmp/
.scratch/
# Local secrets: never commit API keys or caller tokens.
caller-token.txt
*-token.txt
*.key
# Machine-local values for the .bat scripts (LAN IP, upstream proxy).
proxy-local.bat

# Machine-local tool runtime state.
.omo/

# Agent session workspace (subagent plans, scratch state). Never commit.
.zcode/

# Pytest agent-trace and repro artifacts (regenerated by test runs).
.tmp-pytest/

# Stray review diffs. Never commit.
.review-src.diff

# Local runtime logs and request dumps (machine-local).
logs/

# Local-only diag helpers (kept in tree, never committed).
scripts/diag/turns_report.py
